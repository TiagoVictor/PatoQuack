{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Voice": {
    "MaxParticipantsPerRoom": 8
  },
  "Chat": {
    "DatabasePath": "data/patoquack.db",
    "RetentionDays": 30,
    "HistoryPageSize": 50,
    "MaxMessageLength": 2000,
    "RateLimitCount": 5,
    "RateLimitWindowSeconds": 5
  }
}
