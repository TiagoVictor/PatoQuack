{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PatoQuack": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "RateLimitPerMinute": 20
  },
  "Servers": {
    "MaxChannelsPerServer": 50,
    "DefaultChannelName": "geral"
  },
  "Voice": {
    "MaxParticipantsPerChannel": 8
  },
  "Chat": {
    "RetentionDays": 30,
    "HistoryPageSize": 50,
    "MaxMessageLength": 2000,
    "RateLimitCount": 5,
    "RateLimitWindowSeconds": 5
  }
}
