{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "App": "Data Source=storage/patoquack.db"
  },
  "App": {
    "PublicUrl": ""
  },
  "Auth": {
    "RateLimitPerMinute": 20
  },
  "Email": {
    "Mode": "Pickup",
    "PickupDirectory": "storage/mail",
    "From": "PatoQuack <no-reply@localhost>",
    "Host": "",
    "Port": 587,
    "Username": ""
  },
  "Voice": {
    "MaxParticipantsPerRoom": 8
  },
  "Chat": {
    "RetentionDays": 30,
    "HistoryPageSize": 50,
    "MaxMessageLength": 2000,
    "RateLimitCount": 5,
    "RateLimitWindowSeconds": 5
  }
}
